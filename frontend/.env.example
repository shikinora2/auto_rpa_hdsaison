# ============================================================
# Frontend Environment Variables — COPY thành .env.development
# hoặc .env.production và điền thông tin thực tế
# ============================================================

# URL backend API (chỉ cần set khi FE và BE chạy trên host KHÁC nhau)
# Nếu FE được serve từ cùng server với BE (production), để trống —
# FE sẽ tự dùng '/api' (relative path).
#
# Ví dụ khi dev local & BE ở VPS:
# VITE_API_BASE_URL=http://123.456.789.0:8000/api
#
# Ví dụ khi dev với BE ở localhost (Vite proxy tự xử lý, không cần set):
# VITE_API_BASE_URL=

VITE_API_BASE_URL=

# WebSocket URL — để trống để tự detect theo window.location.host
# Ví dụ khi dev local & BE ở VPS:
# VITE_WS_BASE_URL=ws://123.456.789.0:8000
VITE_WS_BASE_URL=
