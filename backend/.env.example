# ============================================================
# Backend Environment Variables — COPY thành .env và điền giá trị
# File .env đặt trong thư mục backend/ (bên cạnh main.py)
# ============================================================

# Host & Port lắng nghe
# API_HOST=0.0.0.0
# API_PORT=8000

# CORS: thêm origin của FE nếu FE và BE ở host khác nhau
# Phân cách bằng dấu phẩy, không có khoảng trắng
# Ví dụ: ALLOWED_ORIGINS=http://192.168.1.10:5173,https://myapp.example.com
ALLOWED_ORIGINS=
