# ========================================
# 🔐 SENSITIVE DATA - NEVER COMMIT!
# ========================================

# Thư mục dữ liệu ứng dụng (chứa mọi thứ quan trọng)
app_data/
app_data/**
!app_data/.gitkeep
!app_data/README.md

# Google API Credentials (CRITICAL - KHÔNG BAO GIỜ COMMIT!)
credentials.json
token.json

# File cấu hình cũ (legacy - đã chuyển vào app_data/)
config.json
zalo_accounts.json

# Zalo Sessions (chứa cookies, auth tokens)
zalo_session/
zalo_session_*/

# ========================================
# 📥 DOWNLOADED FILES - TOO LARGE
# ========================================

# Hợp đồng tải về từ RPA (có dữ liệu khách hàng)
downloads_contracts/
downloads_contracts/**
!downloads_contracts/README.md

# Excel exports (có thể chứa dữ liệu nhạy cảm)
*.xlsx
!template*.xlsx
!example*.xlsx

# PDF files (thường là hợp đồng)
*.pdf

